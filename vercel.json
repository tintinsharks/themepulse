{
  "headers": [
    {
      "source": "/dashboard_data.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }
      ]
    },
    {
      "source": "/market_monitor.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }
      ]
    }
  ],
  "functions": {
    "api/live.js": {
      "maxDuration": 30
    },
    "api/tqqq-analyze.js": {
      "maxDuration": 60
    },
    "api/catalyst-summary.js": {
      "maxDuration": 30
    },
    "api/earnings-call.js": {
      "maxDuration": 30
    },
    "api/gapper-reasoning.js": {
      "maxDuration": 15
    },
    "api/ohlc.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
