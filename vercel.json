{
  "headers": [
    {
      "source": "/dashboard_data.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }
      ]
    },
    {
      "source": "/market_monitor.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }
      ]
    },
    {
      "source": "/(rvol|pm|ah)_picks.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }
      ]
    }
  ],
  "functions": {
    "api/live.js": {
      "maxDuration": 30
    },
    "api/wheel.js": {
      "maxDuration": 20
    },
    "api/schwab-callback.js": {
      "maxDuration": 15
    },
"api/ohlc.js": {
      "maxDuration": 15
    },
    "api/scan-scores.js": {
      "maxDuration": 30
    },
    "api/market-quality.js": {
      "maxDuration": 30
    },
    "api/analyze-ticker.js": {
      "maxDuration": 30
    },
    "api/theme-analysis.js": {
      "maxDuration": 10
    },
    "api/userdata.js": {
      "maxDuration": 10
    },
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/earnings.js": {
      "maxDuration": 15
    }  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
