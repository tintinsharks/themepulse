//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// NVDA Put Entries — SELL PUT / BUY PUT markers, calibrated to the 2024-26 backtest
//
// The chart states the trade, not the indicator. Two markers only:
//
//   SELL PUT (green label under bar) — bullish reversal trigger:
//       RSI(14) recrossed UP through 40   n=23  10d median +8.0%  win 82%  (large label)
//       MACD bullish cross                n=23  10d median +3.2%  win 73%  (small label)
//   BUY PUT (red label above bar) — the ONLY trigger with measured bearish edge:
//       RSI(14) recrossed DOWN through 60 n=24  10d median −1.3%  win 37%
//
// Deliberately absent: MACD bearish crosses and RSI-70 exits. In this sample
// they were INVERTED — NVDA rose a median +6.7% / +5.1% over the next 10d, and
// a put-buy sim on them lost $278/contract at a 14% win rate. Enable
// "show inverted dip markers" to see them as faint gray dots for context.
//
// Baseline for all numbers: +1.65% median 10d forward, any random day,
// 619 bars Feb 2024 → Aug 2026 (+222% drift — one regime; recheck in a downtrend).
// ─────────────────────────────────────────────────────────────────────────────
indicator("NVDA Put Entries — SELL/BUY PUT (backtest-calibrated)", overlay = true)

// ── Inputs ──
rsiLen   = input.int(14, "RSI length", minval = 2)
bullLvl  = input.int(40, "SELL PUT: RSI recross-up level", minval = 5,  maxval = 50)
bearLvl  = input.int(60, "BUY PUT: RSI recross-down level", minval = 50, maxval = 95)
fastLen  = input.int(12, "MACD fast"), slowLen = input.int(26, "MACD slow"), sigLen = input.int(9, "MACD signal")
cooldown = input.int(5, "Cooldown bars between same-side markers", minval = 0,
     tooltip = "Suppresses repeat markers within N bars so clusters read as one entry area.")
showZone = input.bool(true, "Shade setup zones")
showInv  = input.bool(false, "Show inverted dip markers (gray — NOT put-buy triggers)")
showPanel= input.bool(true, "Show state panel")

// ── Indicators ──
r = ta.rsi(close, rsiLen)
[macdLine, signalLine, histLine] = ta.macd(close, fastLen, slowLen, sigLen)

// ── Raw triggers ──
rsiBull  = ta.crossover(r, bullLvl)          // strongest: +8.0% median 10d, 82% win
macdBull = ta.crossover(macdLine, signalLine)
rsiBear  = ta.crossunder(r, bearLvl)         // only measured bearish edge
macdBear = ta.crossunder(macdLine, signalLine)   // inverted — dip context only
rsiExtDn = ta.crossunder(r, 70)                  // inverted — dip context only

// ── Cooldown so clustered triggers read as one entry area ──
var int lastSell = -99999
var int lastBuy  = -99999
sellRaw = rsiBull or macdBull
sellSig = sellRaw and (bar_index - lastSell > cooldown)
if sellSig
    lastSell := bar_index
buySig = rsiBear and (bar_index - lastBuy > cooldown)
if buySig
    lastBuy := bar_index
// Tag the stronger variant when RSI-40 drove the marker
sellStrong = sellSig and rsiBull

// ── Zones: where the setup is building, before the trigger ──
bgcolor(showZone and r < bullLvl ? color.new(color.green, 87) : na, title = "SELL-PUT setup forming (RSI<40 — wait for recross up)")
bgcolor(showZone and r > bearLvl ? color.new(color.red, 92)   : na, title = "BUY-PUT setup forming (RSI>60 — wait for recross down)")

// ── The trade markers ──
plotshape(sellStrong,            "SELL PUT (RSI trigger — strongest)", shape.labelup,   location.belowbar, color.new(color.green, 0), text = "SELL\nPUT", textcolor = color.white, size = size.normal)
plotshape(sellSig and not sellStrong, "SELL PUT (MACD trigger)",       shape.labelup,   location.belowbar, color.new(color.teal, 0),  text = "SELL\nPUT", textcolor = color.white, size = size.small)
plotshape(buySig,                "BUY PUT",                            shape.labeldown, location.abovebar, color.new(color.red, 0),   text = "BUY\nPUT",  textcolor = color.white, size = size.normal)
plotshape(showInv and (macdBear or rsiExtDn), "Inverted (historical dip — not a put-buy)", shape.circle, location.abovebar, color.new(color.gray, 55), size = size.tiny)

// ── State panel ──
var table t = table.new(position.top_right, 2, 3, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.new(color.gray, 70))
if barstate.islast and showPanel
    table.cell(t, 0, 0, "RSI",  text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 0, str.tostring(r, "#.#"), text_color = r < bullLvl ? color.green : r > bearLvl ? color.red : color.gray, text_size = size.small)
    table.cell(t, 0, 1, "MACD", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, macdLine > signalLine ? "bull" : "bear", text_color = macdLine > signalLine ? color.green : color.red, text_size = size.small)
    table.cell(t, 0, 2, "next", text_color = color.gray, text_size = size.small)
    nxt = r < bullLvl ? "SELL PUT on RSI > " + str.tostring(bullLvl) : r > bearLvl ? "BUY PUT on RSI < " + str.tostring(bearLvl) : "no setup forming"
    table.cell(t, 1, 2, nxt, text_color = r < bullLvl ? color.green : r > bearLvl ? color.red : color.silver, text_size = size.small)

// ── Alerts ──
alertcondition(sellSig, "SELL PUT signal", "NVDA SELL PUT — bullish reversal trigger (RSI-40 recross: +8.0% median 10d, 82% win; MACD cross: +3.2%, 73%).")
alertcondition(buySig,  "BUY PUT signal",  "NVDA BUY PUT — RSI recrossed down through 60 (−1.3% median 10d, 37% win rate up). Only trigger with measured bearish edge; size accordingly.")
